<!doctype html>

<html lang="en">

<head>

    <meta charset="utf-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>
        Export Complete — ComicCraft
    </title>

    <link
        rel="stylesheet"
        href="{{ url_for('static', path='css/styles.css') }}"
    >

</head>


<body>

<main class="success">

    <div class="success-card">

        <div class="success-icon">
            ✓
        </div>

        <p class="eyebrow">
            EXPORT COMPLETE
        </p>

        <h1>
            Your comic is ready.
        </h1>

        <p>
            Your PDF has been generated successfully.
        </p>


        {% if pdf_path %}

        <a
            class="primary-btn"
            href="{{ pdf_path }}"
            download
        >
            Download PDF
        </a>

        {% endif %}


        <a
            class="secondary-btn"
            href="/"
        >
            Go Create Another Comic
        </a>

    </div>

</main>

</body>

</html>